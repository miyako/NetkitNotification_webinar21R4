{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 10,
	"bottomMargin": 10,
	"events": [
		"onLoad",
		"onUnload"
	],
	"windowTitle": "Notifications",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"Tab Control": {
					"type": "tab",
					"text": "Tab control",
					"top": 10,
					"left": 10,
					"width": 920,
					"height": 510,
					"dataSource": "Form:C1466.titles",
					"dataSourceTypeHint": "object",
					"sizingX": "grow",
					"sizingY": "grow",
					"action": "gotoPage"
				},
				"Variable2": {
					"type": "input",
					"top": 58,
					"left": 130,
					"width": 307,
					"height": 17,
					"dataSource": "Form:C1466.microsoftEmailAddress",
					"class": "field",
					"dragging": "none",
					"dropping": "custom",
					"events": [
						"onDataChange"
					],
					"enterable": false,
					"contextMenu": "none"
				},
				"Texte3": {
					"type": "text",
					"top": 59,
					"left": 22,
					"width": 98,
					"height": 16,
					"text": "Email address:",
					"textAlign": "right",
					"class": "label"
				},
				"MIcrosoftConnectBt": {
					"type": "button",
					"text": "Sign In",
					"top": 39,
					"left": 690,
					"width": 110,
					"height": 54,
					"events": [
						"onClick"
					],
					"style": "regular",
					"icon": "/RESOURCES/Microsoft.png",
					"textPlacement": "bottom",
					"imageHugsTitle": true,
					"method": "ObjectMethods/MIcrosoftConnectBt.4dm",
					"sizingX": "move"
				},
				"MIcrosoftInboxBt": {
					"type": "button",
					"text": "live.com",
					"top": 39,
					"left": 810,
					"width": 110,
					"height": 54,
					"events": [
						"onClick"
					],
					"style": "regular",
					"icon": "/RESOURCES/Microsoft.png",
					"textPlacement": "bottom",
					"imageHugsTitle": true,
					"method": "ObjectMethods/MIcrosoftInboxBt.4dm",
					"sizingX": "move"
				}
			}
		},
		{
			"objects": {
				"EmailsListbox": {
					"type": "listbox",
					"left": 20,
					"top": 100,
					"width": 900,
					"height": 400,
					"events": [],
					"listboxType": "collection",
					"dataSource": "Form:C1466.emails",
					"currentItemSource": "Form:C1466.currentEmail",
					"selectedItemsSource": "Form:C1466.selectedEmails",
					"rowHeight": "1em",
					"headerHeight": "1em",
					"class": "mail-list",
					"hideFocusRing": true,
					"hideExtraBlankRows": true,
					"resizingMode": "legacy",
					"verticalAlign": "middle",
					"alternateFill": "automaticAlternate",
					"horizontalLineStroke": "transparent",
					"verticalLineStroke": "transparent",
					"staticColumnCount": 4,
					"columns": [
						{
							"header": {
								"text": "Status",
								"name": "HeaderStatus"
							},
							"name": "ColStatus",
							"dataSource": "This:C1470.type",
							"width": 80,
							"truncateMode": "withEllipsis",
							"footer": {
								"name": "Footer1"
							},
							"dataSourceTypeHint": "text",
							"enterable": false
						},
						{
							"header": {
								"text": "From",
								"name": "HeaderSender"
							},
							"name": "ColSender",
							"dataSource": "This:C1470.sender.emailAddress.address",
							"width": 213,
							"truncateMode": "withEllipsis",
							"footer": {
								"name": "Footer2"
							},
							"enterable": false
						},
						{
							"header": {
								"text": "Subject",
								"name": "HeaderSubject"
							},
							"name": "ColSubject",
							"dataSource": "This:C1470.subject",
							"width": 320,
							"truncateMode": "withEllipsis",
							"footer": {
								"name": "Footer3"
							},
							"enterable": false
						},
						{
							"header": {
								"text": "Date",
								"name": "HeaderDate"
							},
							"name": "ColDate",
							"dataSource": "This:C1470.sentDateTime",
							"dataSourceTypeHint": "date",
							"width": 40,
							"footer": {
								"name": "Footer4"
							},
							"enterable": false
						}
					]
				}
			}
		},
		{
			"objects": {
				"ViewProArea": {
					"type": "view",
					"left": 20,
					"top": 100,
					"width": 900,
					"height": 400,
					"userInterface": "none",
					"withFormulaBar": false,
					"method": "ObjectMethods/ViewProArea.4dm",
					"events": [
						"onVPReady",
						"onDoubleClick"
					],
					"sizingX": "grow",
					"sizingY": "grow",
					"visibility": "visible"
				}
			}
		}
	],
	"geometryStamp": 188,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"method": "method.4dm"
}
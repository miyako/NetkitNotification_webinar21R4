{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad"
	],
	"windowTitle": "Notifications",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"Tab Control": {
					"type": "tab",
					"text": "Tab control",
					"top": 1,
					"left": 7,
					"width": 1116,
					"height": 714,
					"dataSource": "_TabTitles",
					"dataSourceTypeHint": "object",
					"sizingX": "grow",
					"sizingY": "grow",
					"action": "gotoPage"
				},
				"Variable2": {
					"type": "input",
					"top": 58,
					"left": 130,
					"width": 307,
					"height": 17,
					"dataSource": "Form:C1466.microsoftEmailAddress",
					"dragging": "none",
					"dropping": "custom",
					"events": [
						"onDataChange"
					],
					"enterable": false,
					"contextMenu": "none"
				},
				"Texte3": {
					"type": "text",
					"top": 59,
					"left": 22,
					"width": 98,
					"height": 16,
					"text": "Email address:",
					"textAlign": "right"
				}
			}
		},
		{
			"objects": {
				"MIcrosoftConnectBt": {
					"type": "button",
					"text": "Sign in   ",
					"top": 51,
					"left": 981,
					"width": 109,
					"height": 33,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/MIcrosoftConnectBt.4dm",
					"style": "custom",
					"fontWeight": "bold",
					"fontSize": 14,
					"stroke": "#5E5E5E",
					"borderStyle": "solid",
					"textAlign": "right",
					"imageHugsTitle": false,
					"customBorderX": 5
				},
				"Static Picture1": {
					"type": "picture",
					"top": 54,
					"left": 988,
					"width": 28,
					"height": 26,
					"picture": "/RESOURCES/Microsoft.png"
				},
				"EmailsListbox": {
					"type": "listbox",
					"left": 14,
					"top": 113,
					"width": 1076,
					"height": 577,
					"events": [
						"onClick",
						"onHeaderClick",
						"onDataChange",
						"onSelectionChange"
					],
					"listboxType": "collection",
					"dataSource": "Form:C1466.emails",
					"currentItemSource": "Form:C1466.currentEmail",
					"selectedItemsSource": "Form:C1466.selectedEmails",
					"rowHeight": "36px",
					"headerHeight": "32px",
					"alternateBackground": "#F9F9F9",
					"hideFocusRing": true,
					"hideExtraBlankRows": true,
					"resizingMode": "legacy",
					"verticalAlign": "middle",
					"columns": [
						{
							"header": {
								"text": "Status",
								"name": "HeaderStatus"
							},
							"name": "ColStatus",
							"dataSource": "This:C1470.type",
							"width": 80,
							"truncateMode": "withEllipsis",
							"footer": {
								"name": "Footer1"
							},
							"dataSourceTypeHint": "text"
						},
						{
							"header": {
								"text": "From",
								"name": "HeaderSender"
							},
							"name": "ColSender",
							"dataSource": "This:C1470.sender.emailAddress.address",
							"width": 213,
							"truncateMode": "withEllipsis",
							"footer": {
								"name": "Footer2"
							}
						},
						{
							"header": {
								"text": "Subject",
								"name": "HeaderSubject"
							},
							"name": "ColSubject",
							"dataSource": "This:C1470.subject",
							"width": 598,
							"truncateMode": "withEllipsis",
							"footer": {
								"name": "Footer3"
							}
						},
						{
							"header": {
								"text": "Date",
								"name": "HeaderDate"
							},
							"name": "ColDate",
							"dataSource": "This:C1470.sentDateTime",
							"dataSourceTypeHint": "date",
							"width": 100,
							"footer": {
								"name": "Footer4"
							}
						}
					]
				}
			}
		},
		{
			"objects": {
				"ViewProArea": {
					"type": "view",
					"left": 21,
					"top": 106,
					"width": 1080,
					"height": 555,
					"userInterface": "none",
					"withFormulaBar": false,
					"method": "ObjectMethods/ViewProArea.4dm",
